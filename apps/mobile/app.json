{
  "expo": {
    "name": "Church App",
    "slug": "church-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "churchapp",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.churchapp.app" },
    "android": { "package": "com.churchapp.app" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000",
      "router": {
        "entry": "./app/_layout.tsx"
      },
      "googleClientId": "520104571386-bfmr77vb7rggo5qc2643jiaopk11m920.apps.googleusercontent.com",
      "googleRedirectUri": "http://localhost:8081/+expo-auth-session"
    }
  }
}
