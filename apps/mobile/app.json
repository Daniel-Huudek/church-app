{
  "expo": {
    "name": "ipiavare",
    "slug": "ipiavare",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "ipiavare",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.ipiavare.ios"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008CFF"
      },
      "package": "com.ipiavare.android"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.ipiavare.com.br",
      "router": {
        "entry": "./app/_layout.tsx",
        "origin": false
      },
      "googleClientId": "520104571386-k3t9hp4e1fod8i4s1u538d4ekmnljj6j.apps.googleusercontent.com",
      "googleAndroidClientId": "520104571386-k3t9hp4e1fod8i4s1u538d4ekmnljj6j.apps.googleusercontent.com",
      "googleIosClientId": "520104571386-9mab6sjfvl3840hiju094f6b4k54netl.apps.googleusercontent.com",
      "eas": {
        "projectId": "df12c7ac-c627-42c1-839a-f17f05dd38cc"
      }
    },
    "owner": "inspeare-software-house"
  }
}
