{
  "expo": {
    "name": "Church App",
    "slug": "church-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "churchapp",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.churchapp.app"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008CFF"
      },
      "package": "com.churchapp.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.ipiavare.com.br",
      "router": {
        "entry": "./app/_layout.tsx"
      },
      "googleClientId": "520104571386-bfmr77vb7rggo5qc2643jiaopk11m920.apps.googleusercontent.com",
      "googleRedirectUri": "http://localhost:8081/+expo-auth-session"
    }
  }
}
