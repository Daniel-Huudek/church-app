generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Schedule {
  id          String   @id @default(uuid())
  eventId     String
  ministryId  String
  date        DateTime
  startTime   String
  endTime     String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  positions   SchedulePosition[]

  @@index([eventId])
  @@index([ministryId])
  @@index([deletedAt])
  @@map("schedules")
}

model SchedulePosition {
  id              String   @id @default(uuid())
  scheduleId      String
  memberId        String
  position        String
  isConfirmed     Boolean  @default(false)
  isSubstituted   Boolean  @default(false)
  substitutedById String?
  createdAt       DateTime @default(now())
  schedule        Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([scheduleId])
  @@map("schedule_positions")
}