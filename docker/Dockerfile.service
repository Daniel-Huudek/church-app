# syntax=docker/dockerfile:1
# Low-RAM multi-stage image for VPS/Dokploy (~4GB).
# SERIAL builds only — parallel builds will OOM a 4GB box.
#
#   ./scripts/docker-build-vps.sh
#   DOCKER_BUILDKIT=1 docker compose build --parallel 1

ARG SERVICE
ARG PORT=3000
ARG PACKAGE_NAME
ARG HAS_PRISMA=true

FROM node:22-alpine AS base
RUN apk add --no-cache openssl wget \
  && corepack enable \
  && corepack prepare pnpm@10.12.1 --activate
WORKDIR /app
# Cap Node heap so one build cannot eat the whole VPS
ENV HUSKY=0 \
    CI=1 \
    NODE_OPTIONS=--max-old-space-size=384

# ── deps (cached unless lockfile / package.json change) ───────────────────────
FROM base AS deps
ARG SERVICE
ARG PACKAGE_NAME
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml .npmrc ./
COPY apps/${SERVICE}/package.json ./apps/${SERVICE}/
COPY packages/shared/package.json ./packages/shared/
COPY packages/tsconfig/package.json ./packages/tsconfig/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
    && pnpm config set network-concurrency 2 \
    && pnpm config set child-concurrency 1 \
    && pnpm fetch --frozen-lockfile \
    && pnpm install --frozen-lockfile --offline --ignore-scripts --filter "${PACKAGE_NAME}..."

# ── build: fat JS bundle (deps inlined; only @prisma/client stays external) ───
FROM deps AS build
ARG SERVICE
ARG PACKAGE_NAME
ARG HAS_PRISMA

COPY packages/tsconfig/ ./packages/tsconfig/
COPY packages/shared/ ./packages/shared/
RUN pnpm --filter @church-app/shared build

COPY apps/${SERVICE}/ ./apps/${SERVICE}/
RUN npm install -g esbuild@0.25.5 --no-fund --no-audit

WORKDIR /app/apps/${SERVICE}
# prisma generate needed so esbuild can type-resolve / so engines exist for copy hints
RUN if [ "$HAS_PRISMA" = "true" ] && [ -f prisma/schema.prisma ]; then \
      pnpm exec prisma generate; \
    fi \
 && if [ "$HAS_PRISMA" = "true" ]; then \
      esbuild src/index.ts \
        --bundle --platform=node --target=node22 --format=esm \
        --outfile=dist/index.js \
        --external:@prisma/client \
        --banner:js="import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);"; \
    else \
      esbuild src/index.ts \
        --bundle --platform=node --target=node22 --format=esm \
        --outfile=dist/index.js \
        --banner:js="import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);"; \
    fi

# Minimal artifact — no pnpm deploy (that step alone can freeze a 4GB VPS)
RUN mkdir -p /out/dist \
 && cp dist/index.js /out/dist/index.js \
 && cp start.sh /out/start.sh \
 && chmod +x /out/start.sh \
 && cp package.json /out/package.json \
 && if [ -d prisma ]; then cp -R prisma /out/prisma; fi

# ── runner: tiny runtime (fat bundle + optional prisma CLI via npm) ───────────
FROM node:22-alpine AS runner
ARG PORT
ARG HAS_PRISMA=true
RUN apk add --no-cache openssl wget
WORKDIR /app
ENV NODE_ENV=production \
    PORT=${PORT} \
    NODE_OPTIONS=--max-old-space-size=64
COPY --from=build /out ./

# Only Prisma packages are needed at runtime (everything else is in the bundle).
# A tiny npm install here is far cheaper than pnpm deploy of the whole graph.
RUN if [ "$HAS_PRISMA" = "true" ] && [ -f prisma/schema.prisma ]; then \
      PRISMA_VER="$(node -p "require('./package.json').dependencies.prisma || require('./package.json').dependencies['@prisma/client'] || '5.22.0'")" \
      && npm install --omit=dev --no-audit --no-fund --maxsockets=2 \
           "@prisma/client@${PRISMA_VER}" "prisma@${PRISMA_VER}" \
      && ./node_modules/.bin/prisma generate \
      && npm cache clean --force; \
    fi \
 && rm -f package.json \
 && chown -R node:node /app

USER node
EXPOSE ${PORT}
CMD ["./start.sh"]
