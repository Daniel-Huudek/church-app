{
  "name": "church-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:build": "DOCKER_BUILDKIT=1 COMPOSE_BAKE=true docker compose build",
    "docker:bake": "DOCKER_BUILDKIT=1 docker buildx bake -f docker-bake.hcl",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky install"
  },
  "pnpm": {
    "overrides": {
      "metro": "0.81.5"
    }
  },
  "dependencies": {
    "metro-runtime": "0.81.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "bcryptjs": "^2.4.3",
    "husky": "^9.0.11",
    "pretty-format": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
