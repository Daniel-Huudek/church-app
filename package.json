{
  "name": "church-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "docker:build": "DOCKER_BUILDKIT=1 docker compose build --parallel 1",
    "docker:build:vps": "sh scripts/docker-build-vps.sh",
    "docker:bake": "DOCKER_BUILDKIT=1 docker buildx bake -f docker-bake.hcl",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky install",
    "docker:deploy:vps": "sh scripts/docker-deploy-vps.sh",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --no-build",
    "docker:pull:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml pull"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "bcryptjs": "^2.4.3",
    "husky": "^9.0.11",
    "pretty-format": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
